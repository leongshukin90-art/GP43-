{{!-- Packages list - frontend-staff --}}

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Parcels</h2>
    <a href="/staff/packages/create" class="btn btn-warning">Receive parcel</a>
  </div>

  {{#if success}}
  <div class="alert alert-success">{{success}}</div>
  {{/if}}
  {{#if error}}
  <div class="alert alert-danger">{{error}}</div>
  {{/if}}

  <div class="card mb-3">
    <div class="card-body">
      <form method="GET" action="/staff/packages" class="row g-2 align-items-end">
        <div class="col-md-4">
          <label class="form-label">Search</label>
          <input type="text" name="q" class="form-control" value="{{filters.q}}" placeholder="Tracking or name">
        </div>
        <div class="col-md-3">
          <label class="form-label">Status</label>
          <select name="status" class="form-select">
            <option value="">All</option>
            {{#each statuses}}
            <option value="{{this}}" {{#if (eq this ../filters.status)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Type</label>
          <select name="type" class="form-select">
            <option value="">All</option>
            {{#each types}}
            <option value="{{this}}" {{#if (eq this ../filters.type)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      Parcel List {{#if total}}({{total}}){{/if}}
    </div>
    <div class="card-body">
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Tracking</th>
            <th>Recipient</th>
            <th>Type</th>
            <th>Status</th>
            <th>Pickup Code</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each packages}}
          <tr>
            <td>{{trackingNo}}</td>
            <td>{{recipientName}}</td>
            <td>{{type}}</td>
            <td>{{status}}</td>
            <td>{{#if pickupCode}}{{pickupCode}}{{else}}-{{/if}}</td>
            <td><a href="/staff/packages/{{id}}">View</a></td>
          </tr>
          {{else}}
          <tr>
            <td colspan="6" class="text-center">No parcels yet.</td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      {{#if pagination}}
      <nav>
        <ul class="pagination mb-0">
          {{#each pagination}}
          <li class="page-item {{#if active}}active{{/if}}">
            <a class="page-link" href="{{url}}">{{number}}</a>
          </li>
          {{/each}}
        </ul>
      </nav>
      {{/if}}
    </div>
  </div>
</div>
