{{!-- Exception reporting and resolution page. --}}
<div class="mb-4">
  <p class="text-danger fw-semibold text-uppercase small mb-1">Problem handling</p>
  <h1 class="h2 mb-0">Exception parcels</h1>
</div>

{{> alerts}}

<div class="row g-4">
  <div class="col-xl-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Report an exception</h2></div>
      <div class="card-body">
        <form method="post" action="/staff/exceptions" class="vstack gap-3">
          <div>
            <label class="form-label" for="packageId">Parcel</label>
            <select class="form-select" id="packageId" name="packageId" required>
              <option value="">Select parcel</option>
              {{#each eligiblePackages}}<option value="{{id}}" {{#if (eq ../selectedPackageId id)}}selected{{/if}}>{{trackingNo}} · {{recipientName}}</option>{{/each}}
            </select>
          </div>
          <div>
            <label class="form-label" for="type">Issue type</label>
            <select class="form-select" id="type" name="type" required>
              <option value="">Select type</option>
              <option>Damaged</option><option>Lost</option><option>Address issue</option><option>Refused</option><option>Other</option>
            </select>
          </div>
          <div>
            <label class="form-label" for="description">Description</label>
            <textarea class="form-control" id="description" name="description" rows="4" required></textarea>
          </div>
          <button class="btn btn-danger" type="submit">Report exception</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-xl-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Exception register</h2></div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead><tr><th>Parcel</th><th>Issue</th><th>Status</th><th>Reported</th><th></th></tr></thead>
          <tbody>
            {{#each exceptions}}
              <tr>
                <td>
                  {{#if parcel}}<a class="fw-semibold text-decoration-none" href="/staff/packages/{{parcel.id}}">{{parcel.trackingNo}}</a>{{else}}Unknown{{/if}}
                  <div class="small text-secondary">{{description}}</div>
                </td>
                <td>{{type}}</td>
                <td><span class="badge text-bg-{{#if (eq status "Open")}}danger{{else}}success{{/if}}">{{status}}</span></td>
                <td>{{formatDate createdAt}}</td>
                <td class="text-end">
                  {{#if (eq status "Open")}}
                    <form method="post" action="/staff/exceptions/{{id}}/resolve" data-confirm="Mark this exception as resolved?"><button class="btn btn-sm btn-outline-success" type="submit">Resolve</button></form>
                  {{/if}}
                </td>
              </tr>
            {{else}}
              <tr><td colspan="5" class="text-center text-secondary py-5">No exceptions recorded.</td></tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
