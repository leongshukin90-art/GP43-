{{!-- Staff Dashboard - frontend-staff --}}

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Staff Dashboard</h2>
    <a href="/staff/packages/create" class="btn btn-warning">Receive parcel</a>
  </div>

  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h6 class="text-muted">Total Packages</h6>
          <h3>{{totalPackages}}</h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h6 class="text-muted">Arrived</h6>
          <h3>{{counts.Arrived}}</h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h6 class="text-muted">Notified</h6>
          <h3>{{counts.Notified}}</h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h6 class="text-muted">Exceptions</h6>
          <h3>{{counts.Exception}}</h3>
        </div>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-3">
      <div class="card text-center">
        <div class="card-body">
          <h6 class="text-muted">Active Shelves</h6>
          <h3>{{activeShelves}}</h3>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      Quick Actions
    </div>
    <div class="card-body">
      <a href="/staff/packages" class="btn btn-outline-secondary me-2">View parcels</a>
      <a href="/staff/shelves" class="btn btn-outline-secondary me-2">Manage shelves</a>
      <a href="/staff/exceptions" class="btn btn-outline-secondary me-2">Handle exceptions</a>
      <a href="/staff/packages/create" class="btn btn-warning">Receive parcel</a>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-header">Recent arrivals</div>
    <div class="card-body">
      {{#if recentArrivals}}
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead>
              <tr><th>Tracking</th><th>Recipient</th><th>Status</th><th>Arrived</th><th></th></tr>
            </thead>
            <tbody>
              {{#each recentArrivals}}
              <tr>
                <td>{{trackingNo}}</td>
                <td>{{recipientName}}</td>
                <td><span class="badge text-bg-{{statusClass status}}">{{status}}</span></td>
                <td>{{formatDateOnly arrivedAt}}</td>
                <td><a href="/staff/packages/{{id}}">View</a></td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <p class="text-secondary mb-0">No parcels have arrived yet.</p>
      {{/if}}
    </div>
  </div>
</div>
