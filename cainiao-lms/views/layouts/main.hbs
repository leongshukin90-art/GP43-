{{!-- Shared HTML shell and Bootstrap asset loading for every page. --}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · {{siteConfig.siteName}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body class="bg-body-tertiary">
  {{#unless hideNavigation}}
    {{> nav}}
  {{/unless}}

  <main class="{{#if hideNavigation}}login-shell{{else}}container py-4{{/if}}">
    {{{body}}}
  </main>

  {{#unless hideNavigation}}
    <footer class="container py-4 text-center text-secondary small">
      {{siteConfig.siteName}} · Prototype only · No production data
    </footer>
  {{/unless}}

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
