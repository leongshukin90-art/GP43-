{{!-- Admin account creation, search, and editing forms. --}}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <p class="text-primary fw-semibold text-uppercase small mb-1">Access administration</p>
    <h1 class="h2 mb-0">User management</h1>
  </div>
  <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#newUser">Add user</button>
</div>

{{> alerts}}

<div class="collapse mb-4" id="newUser">
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Create account</h2></div>
    <div class="card-body">
      <form class="row g-3 align-items-end" method="post" action="/admin/users">
        <div class="col-md-2"><label class="form-label" for="username">Username</label><input class="form-control" id="username" name="username" required></div>
        <div class="col-md-2"><label class="form-label" for="password">Password</label><input class="form-control" id="password" name="password" type="password" required></div>
        <div class="col-md-2"><label class="form-label" for="name">Full name</label><input class="form-control" id="name" name="name" required></div>
        <div class="col-md-2"><label class="form-label" for="phone">Phone</label><input class="form-control" id="phone" name="phone" required></div>
        <div class="col-md-2"><label class="form-label" for="role">Role</label><select class="form-select" id="role" name="role" required>{{#each roles}}<option value="{{this}}" class="text-capitalize">{{this}}</option>{{/each}}</select></div>
        <div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Create</button></div>
      </form>
    </div>
  </div>
</div>

<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <form class="row g-3 align-items-end" method="get" action="/admin/users">
      <div class="col-md-7"><label class="form-label" for="q">Search</label><input class="form-control" id="q" name="q" value="{{filters.q}}" placeholder="Username, name or phone"></div>
      <div class="col-md-3"><label class="form-label" for="roleFilter">Role</label><select class="form-select" id="roleFilter" name="role"><option value="">All roles</option>{{#each roles}}<option value="{{this}}" {{selectedIf ../filters.role this}}>{{this}}</option>{{/each}}</select></div>
      <div class="col-md-2 d-grid"><button class="btn btn-outline-primary" type="submit">Filter</button></div>
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead><tr><th>Username</th><th>Name</th><th>Role</th><th>Phone</th><th>Created</th><th></th></tr></thead>
      <tbody>
        {{#each users}}
          <tr>
            <td class="fw-semibold">{{username}}</td>
            <td>{{name}}</td>
            <td><span class="badge text-bg-secondary text-capitalize">{{role}}</span></td>
            <td>{{phone}}</td>
            <td>{{formatDateOnly createdAt}}</td>
            <td class="text-end"><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#editUser{{@index}}">Edit</button></td>
          </tr>
          <tr class="collapse" id="editUser{{@index}}">
            <td colspan="6" class="bg-body-tertiary">
              <form class="row g-3 align-items-end" method="post" action="/admin/users/{{id}}">
                <div class="col-md-2"><label class="form-label">Username</label><input class="form-control" name="username" value="{{username}}" required></div>
                <div class="col-md-2"><label class="form-label">New password</label><input class="form-control" name="password" type="password" placeholder="Unchanged"></div>
                <div class="col-md-2"><label class="form-label">Full name</label><input class="form-control" name="name" value="{{name}}" required></div>
                <div class="col-md-2"><label class="form-label">Phone</label><input class="form-control" name="phone" value="{{phone}}" required></div>
                <div class="col-md-2"><label class="form-label">Role</label><select class="form-select" name="role" required>{{#each ../roles}}<option value="{{this}}" {{selectedIf ../role this}}>{{this}}</option>{{/each}}</select></div>
                <div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Save</button></div>
              </form>
            </td>
          </tr>
        {{else}}
          <tr><td colspan="6" class="text-center text-secondary py-5">No users match these filters.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
